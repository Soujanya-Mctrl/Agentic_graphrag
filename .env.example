# TigerGraph Database Configuration
# Replace with your TigerGraph Savanna Cloud or local Docker details

# For Savanna Cloud: https://<your-cluster-subdomain>.i.tgcloud.io
# For Local Docker: http://localhost
TG_HOST=https://your-instance.i.tgcloud.io

# Name of your graph schema in TigerGraph
TG_GRAPHNAME=MyGraph

# Database credentials
TG_USERNAME=tigergraph
TG_PASSWORD=your_password

# Set to true if connecting to TigerGraph Cloud / Savanna
TG_TGCLOUD=true
TG_USE_MOCK=false

# Ports (Optional: defaults are 9000/14240 for local, 443 for cloud)
# TG_RESTPP_PORT=443
# TG_GS_PORT=443

# Optional: Token authentication instead of username/password
# TG_API_TOKEN=your_api_token_here

# LLM Provider Configuration (groq, openai, gemini, anthropic)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Alternative Providers:
# OPENAI_API_KEY=your_key_here
# GEMINI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here

# Hugging Face authentication token for gated/private models
# HF_TOKEN=your_hf_token_here

