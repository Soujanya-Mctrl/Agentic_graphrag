/requirements.txt
/requirements-dev.txt
/*.py
/backend/
/src/
/data/
/docs/
/results/
/scripts/
/tests/
/Dockerfile
/render.yaml
/.venv/
/__pycache__/
/.pytest_cache/

# Never ignore anything in frontend
!/frontend/
!/frontend/**
